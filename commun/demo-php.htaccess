# Démonstration de la boutique PHP : la même politique que le reste du site, avec
# les polices locales de la boutique (font-src 'self') et aucun script
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
  Header always set X-Robots-Tag "noindex"
</IfModule>
# La configuration et les fichiers cachés ne se téléchargent pas
<FilesMatch "^(config\.php|\..*)$">
  Require all denied
</FilesMatch>
DirectoryIndex index.php
